# ==============================================================================
# LUCY DIGITAL CAMPUS OS - ENVIRONMENT TEMPLATE
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE & ORM (PostgreSQL & Supabase Pooler)
# ------------------------------------------------------------------------------
DATABASE_URL="postgresql://user:password@host:5432/postgres?sslmode=require"
# Optional but recommended in production: PEM CA certificate of the database server (use \n for newlines).
# When set, the database TLS certificate is verified. When unset, verification is skipped.
# DATABASE_SSL_CA=""
# Secret used to sign student QR credentials. Required in production (falls back to ADMIN_SECRET_KEY).
# QR_HMAC_SECRET=""
DIRECT_URL="postgresql://user:password@host:5432/postgres?sslmode=require"

# ------------------------------------------------------------------------------
# 2. SUPABASE (Auth, Realtime, Storage & DB API)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY="your-supabase-publishable-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# ------------------------------------------------------------------------------
# 3. APP CONFIGURATION & DEPLOYMENT
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="https://5-cn.net"
IS_CLOUDFLARE="true"
ADMIN_SECRET_KEY="your-admin-secret-key"
# Required: /api/cron/backups refuses to run without it. The scheduler must send "Authorization: Bearer <value>".
CRON_SECRET="your-cron-secret"

# Optional: address that receives an email when a payment webhook, payment verification or scheduled job
# fails. At most one email per failure type every 15 minutes.
ALERT_EMAIL=""

# Optional: comma separated extra origins (for example preview deployments) allowed to make
# state-changing browser requests. The app host and NEXT_PUBLIC_APP_URL are always allowed.
ALLOWED_ORIGINS=""

# ------------------------------------------------------------------------------
# 4. POSTHOG ANALYTICS
# ------------------------------------------------------------------------------
NEXT_PUBLIC_POSTHOG_KEY="your-posthog-project-token"
NEXT_PUBLIC_POSTHOG_HOST="https://your-posthog-host"

# ------------------------------------------------------------------------------
# 5. GOOGLE GEMINI AI
# ------------------------------------------------------------------------------
GEMINI_API_KEY="your-gemini-api-key"
GOOGLE_GENERATIVE_AI_API_KEY="your-gemini-api-key"

# ------------------------------------------------------------------------------
# 6. EMAIL SERVICES (Resend & Gmail SMTP)
# ------------------------------------------------------------------------------
RESEND_API_KEY="re_your_resend_api_key"
RESEND_FROM_EMAIL="noreply@5-cn.net"
GMAIL_USER="your-email@gmail.com"
GMAIL_APP_PASSWORD="your-app-password"

# ------------------------------------------------------------------------------
# 7. CLOUDFLARE TURNSTILE
# ------------------------------------------------------------------------------
NEXT_PUBLIC_TURNSTILE_SITE_KEY="your-turnstile-site-key"
TURNSTILE_SECRET_KEY="your-turnstile-secret-key"

# ------------------------------------------------------------------------------
# 8. PAYMENTS & BILLING GATEWAYS (STRIPE)
# ------------------------------------------------------------------------------
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_ACCOUNT_ID="acct_..."
NEXT_PUBLIC_STRIPE_ACCOUNT_ID="acct_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
CHAPA_SECRET_KEY=""
CHAPA_WEBHOOK_SECRET=""

# ETB pricing for Chapa. The live market rate is used by default; set these to control it.
# USD_ETB_RATE_OVERRIDE: fixed rate (for example your bank's selling rate); beats any live source.
# USD_ETB_RATE_FALLBACK: used only if no live or cached rate is available. Without it checkout pauses.
# FX_MARGIN_PERCENT: added on top of the rate to cover bank spread and movement (default 2).
USD_ETB_RATE_OVERRIDE=""
USD_ETB_RATE_FALLBACK=""
FX_MARGIN_PERCENT="2"

# ------------------------------------------------------------------------------
# 9. CACHE & KEY-VALUE STORE (Upstash Redis)
# ------------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL="https://your-instance.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-token"

# ------------------------------------------------------------------------------
# 10. COMMUNITY & BROADCAST INTEGRATIONS (Telegram & Discord)
# ------------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN="your-telegram-bot-token"
TELEGRAM_CHAT_ID="your-telegram-chat-id"
DISCORD_APPLICATION_ID="your-discord-app-id"
DISCORD_PUBLIC_KEY="your-discord-public-key"
DISCORD_BOT_TOKEN="your-discord-bot-token"
