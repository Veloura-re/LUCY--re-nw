{
  "name": "lucy",
  "main": ".worker-next/index.mjs",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": ".worker-next/assets"
  },
  "kv_namespaces": [
    {
      "binding": "NEXT_INC_CACHE_KV",
      "id": "placeholder_id_for_kv"
    }
  ]
}
