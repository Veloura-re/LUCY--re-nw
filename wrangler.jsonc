{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lucy",
  "main": ".worker-next/index.mjs",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "minify": true,
  "assets": {
    "binding": "ASSETS",
    "directory": ".worker-next/assets"
  },
  "observability": {
    "enabled": true
  }
}
